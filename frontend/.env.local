# Backend URL forwarded to by the Vite dev-server proxy.
# In dev mode config.js sends API calls to localhost:3000 (relative path),
# and Vite proxies them here — so the browser never sees a cross-origin request.
# Prefer VITE_BACKEND_URL for the proxy target. VITE_API_URL is also accepted
# by vite.config.js as a proxy target, but config.js ignores it in dev so the
# browser still uses same-origin relative HTTP URLs.
VITE_BACKEND_URL=http://192.168.1.11:8000

# WebSocket connects directly (WS upgrades are not subject to CORS preflights).
VITE_WS_URL=ws://192.168.1.11:8000
