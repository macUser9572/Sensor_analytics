# ─────────────────────────────────────────────
# Sensor Analytics Platform – Environment Vars
# ─────────────────────────────────────────────

# FastAPI
APP_NAME=SensorAnalytics
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# TimescaleDB / PostgreSQL
POSTGRES_USER=sensor_admin
POSTGRES_PASSWORD=sensor_pass_2026
POSTGRES_DB=sensor_analytics
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sensor_admin:sensor_pass_2026@timescaledb:5432/sensor_analytics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass_2026
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_pass_2026
MINIO_SECURE=false
MINIO_BUCKET=sensor-data
