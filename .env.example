# IMPORTANT: Copy this to .env and set real IPs before starting any service

# -- MACHINE IPs ------------------------------------------------
M1_IP=192.168.1.15
M2_IP=192.168.1.5
M3_IP=192.168.1.18
M4_IP=192.168.1.3

# -- OPC-UA (Machine 1) ----------------------------------------
OPC_PORT=4840
OPC_SERVER_URL=opc.tcp://${M1_IP}:${OPC_PORT}
OPC_NAMESPACE=BHEL_PLANT
OPC_SERVER_NAME=BHEL Plant Simulator
OPC_KEEPALIVE_COUNT=3
OPC_PUBLISH_INTERVAL_MS=10000

# -- Redis (Machine 2) -----------------------------------------
REDIS_HOST=${M2_IP}
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BUFFER_SECONDS=600

# -- FastAPI (Machine 2) ---------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://${M4_IP},http://${M4_IP}:3000,http://${M4_IP}:5173
JWT_SECRET=change_this_in_production
JWT_ALGORITHM=HS256
APP_NAME=BHEL Real-Time Sensor Analytics Platform
APP_ENV=production
APP_DEBUG=false

# -- TimescaleDB (Machine 3) -----------------------------------
DB_HOST=${M3_IP}
DB_PORT=5432
DB_NAME=bhel_plant
DB_USER=bhel_user
DB_PASSWORD=change_this_in_production
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${M3_IP}:${DB_PORT}/${DB_NAME}

# -- MinIO (Machine 3) -----------------------------------------
MINIO_HOST=${M3_IP}
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=bhel_access
MINIO_SECRET_KEY=change_this_in_production
MINIO_BUCKET=bhel-plant-data
MINIO_SECURE=false

# -- Simulator --------------------------------------------------
SIMULATOR_TICK_MS=1000
FAULT_RAMP_STEP=0.5

# -- Alert Thresholds ------------------------------------------
WARNING_THRESHOLD_PCT=0.80
CRITICAL_THRESHOLD_PCT=1.00
WATCHDOG_TIMEOUT_SECONDS=45
WATCHDOG_CHECK_INTERVAL_SECONDS=15

# -- Batch Writer ----------------------------------------------
BATCH_FLUSH_INTERVAL_SECONDS=15

# -- Flutter / React -------------------------------------------
REACT_API_BASE_URL=http://${M2_IP}:8000
REACT_WS_URL=ws://${M2_IP}:8000
FLUTTER_API_BASE_URL=http://${M2_IP}:8000
FLUTTER_WS_URL=ws://${M2_IP}:8000
